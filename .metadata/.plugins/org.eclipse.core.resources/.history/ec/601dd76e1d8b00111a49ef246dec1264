package com.ticketing.repository;


import java.util.List;


import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;


import com.ticketing.entity.TransportBooking;



@Repository
public interface TransportBookingRepository 
        extends JpaRepository<TransportBooking, Long> {


    List<TransportBooking> findByUserId(Long userId);


    List<TransportBooking> findByTransportationId(Long transportationId);

}