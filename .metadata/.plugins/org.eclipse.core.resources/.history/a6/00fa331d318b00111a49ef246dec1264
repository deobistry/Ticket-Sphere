package com.ticketing.service;


import java.time.LocalDateTime;
import java.util.List;
import java.util.UUID;
import java.util.stream.Collectors;


import org.springframework.stereotype.Service;


import com.ticketing.dto.request.PaymentRequest;
import com.ticketing.dto.response.PaymentResponse;
import com.ticketing.entity.AccommodationBooking;
import com.ticketing.entity.Payment;
import com.ticketing.entity.TransportBooking;
import com.ticketing.enums.BookingStatus;
import com.ticketing.enums.PaymentMethod;
import com.ticketing.enums.PaymentStatus;
import com.ticketing.repository.AccommodationBookingRepository;
import com.ticketing.repository.PaymentRepository;
import com.ticketing.repository.TransportBookingRepository;



@Service
public class PaymentService {



    private final PaymentRepository paymentRepository;


    private final TransportBookingRepository transportBookingRepository;


    private final AccommodationBookingRepository accommodationBookingRepository;





    public PaymentService(
            PaymentRepository paymentRepository,
            TransportBookingRepository transportBookingRepository,
            AccommodationBookingRepository accommodationBookingRepository
    ) {

        this.paymentRepository = paymentRepository;
        this.transportBookingRepository = transportBookingRepository;
        this.accommodationBookingRepository = accommodationBookingRepository;
    }







    public PaymentResponse makePayment(
            PaymentRequest request
    ) {



        if(request.getBookingId() == null) {

            throw new RuntimeException(
                    "Booking id required"
            );
        }



        if(request.getAmount() == null) {

            throw new RuntimeException(
                    "Amount required"
            );
        }



        if(request.getBookingType() == null) {

            throw new RuntimeException(
                    "Booking type required"
            );
        }



        Payment payment = new Payment();




        payment.setBookingId(
                request.getBookingId()
        );



        payment.setBookingType(
                request.getBookingType()
        );



        payment.setAmount(
                request.getAmount()
        );



        payment.setPaymentMethod(
                PaymentMethod.valueOf(
                        request.getPaymentMethod()
                                .toUpperCase()
                )
        );



        payment.setPaymentStatus(
                PaymentStatus.SUCCESS
        );



        payment.setTransactionId(
                "TXN-" + UUID.randomUUID()
        );



        payment.setPaymentDate(
                LocalDateTime.now()
        );




        paymentRepository.save(
                payment
        );



        updateBookingStatus(
                request
        );



        return convert(payment);
    }








    private void updateBookingStatus(
            PaymentRequest request
    ) {



        if(request.getBookingType()
                .equalsIgnoreCase("TRANSPORT")) {



            TransportBooking booking =
                    transportBookingRepository.findById(
                            request.getBookingId()
                    )
                    .orElseThrow(
                            () -> new RuntimeException(
                                    "Transport booking not found"
                            )
                    );



            booking.setStatus(
                    BookingStatus.CONFIRMED
            );



            transportBookingRepository.save(
                    booking
            );



        }





        else if(request.getBookingType()
                .equalsIgnoreCase("ACCOMMODATION")) {



            AccommodationBooking booking =
                    accommodationBookingRepository.findById(
                            request.getBookingId()
                    )
                    .orElseThrow(
                            () -> new RuntimeException(
                                    "Accommodation booking not found"
                            )
                    );



            booking.setStatus(
                    BookingStatus.CONFIRMED
            );



            accommodationBookingRepository.save(
                    booking
            );

        }


        else {

            throw new RuntimeException(
                    "Invalid booking type"
            );
        }

    }









    public List<PaymentResponse> getPayments(
            Long bookingId
    ) {


        return paymentRepository
                .findByBookingId(
                        bookingId
                )
                .stream()
                .map(this::convert)
                .collect(Collectors.toList());

    }








    private PaymentResponse convert(
            Payment payment
    ) {


        return new PaymentResponse(

                payment.getId(),

                payment.getBookingId(),

                payment.getBookingType(),

                payment.getAmount(),

                payment.getPaymentMethod()
                        .name(),

                payment.getPaymentStatus(),

                payment.getTransactionId(),

                payment.getPaymentDate()

        );

    }


}